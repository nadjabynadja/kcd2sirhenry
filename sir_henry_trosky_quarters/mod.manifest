<?xml version="1.0" encoding="utf-8"?>
<kcd_mod>
	<info>
		<name>Sir Henry of Skalitz - Trosky Guest Quarters (optional)</name>
		<modid>sir_henry_trosky_quarters</modid>
		<description>Moves Henry's Trosky bed and shared stash into an interior guard-house room, while transferring one anonymous guard, his equipment chest, and Henry's former courtyard accommodations in the opposite direction. No lord's bed is used. Level-data module; see README.md.</description>
		<author>Nadja</author>
		<version>0.2.0</version>
		<created_on>2026-08-25</created_on>
		<modifies_level>true</modifies_level>
	</info>
	<supports>
		<version>1.5*</version>
	</supports>
</kcd_mod>
